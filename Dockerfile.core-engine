# Etapa de construcción
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /core-engine ./cmd/core-engine

# Runtime: alpine con certificados para HTTPS hacia proveedores externos.
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=build /core-engine /usr/local/bin/core-engine
EXPOSE 8081
ENTRYPOINT ["core-engine"]
