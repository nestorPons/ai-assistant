# Runtime: recompila al arrancar y conserva certificados para HTTPS.
FROM golang:1.27-alpine
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
EXPOSE 8081
ENTRYPOINT ["sh", "-c", "CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags='-s -w' -o /usr/local/bin/core-engine ./cmd/core-engine && exec /usr/local/bin/core-engine"]
