# ── Base de datos ──────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=ai_assistant
MARIADB_USER=ai
MARIADB_PASSWORD=ai

# ── llm-anonymizer (interno) ───────────────────────────────────
ANONYMIZER_TOKEN=

# ── Jev (orquestador) ──────────────────────────────────────────
JEV_BASE_URL=https://www.jevai.org
JEV_API_KEY=

# ── OpenAI (extractor) ─────────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Gmail (canal inicial) ──────────────────────────────────────
GMAIL_ACCESS_TOKEN=

# ── Ajustes de procesamiento ───────────────────────────────────
MIN_WORDS=3
WORKER_CONCURRENCY=4
MAX_RETRIES=2
