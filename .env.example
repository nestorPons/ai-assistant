# ── Base de datos ──────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=ai_assistant
MARIADB_USER=ai
MARIADB_PASSWORD=ai

# ── llm-anonymizer (interno) ───────────────────────────────────
ANONYMIZER_TOKEN=

# ── Jev (orquestador) — opcional ───────────────────────────────
# Dejar JEV_API_KEY vacío para deshabilitar Jev y clasificar con el LLM.
JEV_BASE_URL=https://www.jevai.org
JEV_API_KEY=

# ── OpenAI (extractor) ─────────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Clasificador ───────────────────────────────────────────────
# chain: Jev -> LLM remoto -> reglas -> revisión | jev | llm
CLASSIFIER_MODE=chain
# Modelo para el clasificador LLM (por defecto OPENAI_MODEL).
CLASSIFIER_MODEL=

# ── Gmail (canal inicial) ──────────────────────────────────────
# OAuth 2.0: la app renueva el access token con el refresh token.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Opcional: access token estático (solo pruebas; expira en ~1h).
GMAIL_ACCESS_TOKEN=
# Opcional: query de la bandeja para el modo poll (por defecto is:unread).
GMAIL_QUERY=

# ── Gmail push (Pub/Sub) ───────────────────────────────────────
# Modo: poll (consulta por query) o pull (History API + Pub/Sub).
GMAIL_PUSH_MODE=poll
# Topic de Pub/Sub al que Gmail publica (users.watch).
GMAIL_PUBSUB_TOPIC=
# Suscripción pull de la que core-engine lee.
GMAIL_PUBSUB_SUBSCRIPTION=
# Intervalo del polling de respaldo en modo pull (ej: 5m).
GMAIL_POLL_FALLBACK=5m

# ── Ajustes de procesamiento ───────────────────────────────────
MIN_WORDS=3
WORKER_CONCURRENCY=4
MAX_RETRIES=2
