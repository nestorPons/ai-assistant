# Etapa de construcción
FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /llm-anonymizer ./cmd/llm-anonymizer

# Imagen final ultraligera (scratch): solo binario estático.
FROM scratch
COPY --from=build /llm-anonymizer /llm-anonymizer
EXPOSE 8080
ENTRYPOINT ["/llm-anonymizer"]
